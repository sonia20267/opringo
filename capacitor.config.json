{
  "appId": "com.social.opringo",
  "appName": "Opringo",
  "webDir": "www",
  "server": {
    "allowNavigation": [
      "www.opringo.com",
      "*.opringo.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#09090b",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}